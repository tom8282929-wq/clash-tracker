<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/overlay_background"
    android:padding="10dp"
    android:minWidth="180dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CLASH TRACKER"
        android:textColor="@color/text_secondary"
        android:textSize="9sp"
        android:letterSpacing="0.1"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/elixirText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/accent_red"
        android:textSize="16sp"
        android:textStyle="bold"
        android:text="Elixir (est.): 5.0" />

    <TextView
        android:id="@+id/confidenceText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:text="Confidence: --" />

    <TextView
        android:id="@+id/lastPlayedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        android:layout_marginTop="6dp"
        android:text="Last 4: --" />

    <TextView
        android:id="@+id/predictedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#7CFC7C"
        android:textSize="11sp"
        android:text="Likely next: --" />

    <View
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:layout_marginTop="6dp"
        android:background="@color/surface_border" />

</LinearLayout>
